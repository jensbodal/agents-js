{
  "name": "@agents-js/matrix-bridge",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Matrix bridge publisher for the gateway bus. Pure-function envelope builder that turns Matrix events into typed `gateway.matrix.*` bus envelopes, ready for in-process publish or POST to /admin/publish.",
  "author": "Jens Bodal",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.11"
  },
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "bun": "./src/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "package.json"
  ],
  "scripts": {
    "build": "bunx tsdown src/index.ts --format esm --dts --out-dir dist --clean",
    "test": "bun test tests"
  },
  "dependencies": {
    "@agents-js/host": "0.6.0"
  },
  "devDependencies": {
    "@types/bun": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
