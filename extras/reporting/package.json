{
  "name": "@agents-js/reporting",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Deterministic code-review reporting: orchestrates worker envelopes and emits merged findings as markdown and JSON Canvas output.",
  "author": "Jens Bodal",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.11"
  },
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "bun": "./src/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "bin": {
    "agents-report": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "src",
    "package.json"
  ],
  "scripts": {
    "build": "bunx tsdown src/index.ts src/cli.ts --format esm --dts --out-dir dist --clean",
    "test": "bun test tests"
  },
  "dependencies": {
    "@agents-js/gateway-runtime": "0.3.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
