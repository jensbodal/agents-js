{
  "name": "@agents-js/browser-runtime",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Browser-native runtime for the docs meta-agent: WebLLM worker, JSON action loop, ACP shim",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./worker": {
      "types": "./src/webllm-worker.ts",
      "import": "./src/webllm-worker.ts"
    }
  },
  "scripts": {
    "build": "bunx tsdown src/index.ts src/webllm-worker.ts --format esm --dts --out-dir dist --clean",
    "typecheck": "bunx tsgo --noEmit -p tsconfig.json",
    "test": "bun test src"
  },
  "dependencies": {
    "@agents-js/agui-types": "0.6.0",
    "@agents-js/validation": "0.6.0",
    "@mlc-ai/web-llm": "catalog:",
    "ajv": "catalog:",
    "ajv-formats": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@webgpu/types": "catalog:"
  }
}
