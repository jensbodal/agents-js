{
  "name": "@agents-js/pi-extension",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Pi CLI extension that bridges Pi tool calls to A2A agents over MCP or direct A2A transport.",
  "author": "Jens Bodal",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.11"
  },
  "main": "dist/extension.js",
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ]
  },
  "files": [
    "dist",
    "src",
    "package.json"
  ],
  "scripts": {
    "build": "bun build --bundle --minify --outfile dist/extension.js --target node src/node-entry.ts",
    "test": "bun test tests"
  },
  "dependencies": {
    "@a2a-js/sdk": "catalog:",
    "@agents-js/a2a": "0.2.1",
    "@agents-js/a2a-client": "0.2.1",
    "@agents-js/a2ui-types": "0.2.1",
    "@sinclair/typebox": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
