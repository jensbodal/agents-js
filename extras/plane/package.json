{
  "name": "@agents-js/plane",
  "version": "0.2.0-beta-3",
  "type": "module",
  "sideEffects": false,
  "description": "Plane (project management) webhook handler. HMAC-verified fetch handler for Plane issue events with pluggable notifier transport.",
  "author": "Jens Bodal",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.11"
  },
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "bun": "./src/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./mount": {
      "types": "./dist/mount.d.mts",
      "bun": "./src/mount.ts",
      "import": "./dist/mount.mjs",
      "default": "./dist/mount.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "package.json"
  ],
  "scripts": {
    "build": "bunx tsdown src/index.ts src/mount.ts --format esm --dts --out-dir dist --clean",
    "test": "bun test tests"
  },
  "dependencies": {
    "@agents-js/gateway-runtime": "0.2.0-beta-3"
  },
  "devDependencies": {
    "@types/bun": "catalog:"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
