{
  "name": "@agents-js/wake-channel-bridge",
  "version": "0.6.0",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "description": "Gateway-side composition: pulls pending wake signals from @agents-js/wake-signal-store, emits them via @agents-js/claude-channel-adapter, marks delivered on success. Closes the AJS-89 HYBRID SOURCE → CC receiver loop per ADR-0007 revision.",
  "author": "Jens Bodal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jensbodal/agents-js.git",
    "directory": "extras/wake-channel-bridge"
  },
  "homepage": "https://agents-js.bodal.dev/",
  "bugs": {
    "url": "https://github.com/jensbodal/agents-js/issues"
  },
  "keywords": [
    "wake-adapter",
    "claude-channel",
    "gateway",
    "bridge"
  ],
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.11"
  },
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "bun": "./src/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "package.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "bunx tsdown src/index.ts --format esm --dts --out-dir dist --clean",
    "prepack": "bun run build",
    "test": "bun test tests"
  },
  "dependencies": {
    "@agents-js/wake-signal-store": "0.6.0",
    "@agents-js/claude-channel-adapter": "0.6.0",
    "@agents-js/wake-types": "0.6.0"
  },
  "devDependencies": {
    "@types/bun": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
