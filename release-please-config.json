          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/acp/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/acp-host/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/agui-types/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
