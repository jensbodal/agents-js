{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "separate-pull-requests": false,
  "changelog-sections": [
    { "type": "feat", "section": "Added" },
    { "type": "fix", "section": "Fixed" },
    { "type": "perf", "section": "Changed" },
    { "type": "revert", "section": "Changed" },
    { "type": "deps", "section": "Changed" },
    { "type": "chore", "section": "Internal" },
    { "type": "ci", "section": "Internal" },
    { "type": "build", "section": "Internal" },
    { "type": "refactor", "section": "Internal" },
    { "type": "test", "section": "Internal" },
    { "type": "docs", "section": "Internal" },
    { "type": "style", "section": "Internal" }
  ],
  "packages": {
    ".": {
      "package-name": "@agents-js/root",
      "component": "agents-js",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "packages/a2a/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/a2a-client/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/a2ui-host/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/a2ui-renderer/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
