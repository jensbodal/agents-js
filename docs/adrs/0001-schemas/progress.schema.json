{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Progress Log (JSONL)",
  "description": "Line-delimited JSON log of generator progress. Each line is a single progress entry. Output by the Generator role.",
  "type": "object",
  "required": ["timestamp", "type", "feature"],
  "properties": {
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp of this progress event.",
      "format": "date-time"
    },
    "type": {
      "type": "string",
      "description": "Event type.",
      "enum": ["task_start", "task_complete", "task_error", "checkpoint", "note"]
    },
    "feature": {
      "type": "string",
      "description": "Feature ID being worked on (e.g., 'F-001')."
    },
    "task": {
      "type": "string",
      "description": "Short description of the task (e.g., 'implement login endpoint')."
    },
    "status": {
      "type": "string",
      "description": "Current status if type is 'checkpoint'.",
      "enum": ["in_progress", "blocked", "waiting_review"]
    },
    "successSummary": {
      "type": "string",
      "description": "Summary of what was accomplished (for type 'task_complete')."
    },
    "errorSummary": {
      "type": "string",
      "description": "Brief error description (for type 'task_error')."
    },
    "errorDetails": {
      "type": "string",
      "description": "Detailed error trace or logs (for type 'task_error')."
    },
    "context": {
      "type": "object",
      "description": "Additional context (e.g., files modified, tests run).",
      "properties": {
        "filesModified": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "testsRun": {
          "type": "integer",
          "minimum": 0
        },
        "testsPassedCount": {
          "type": "integer",
          "minimum": 0
        },
        "testFailedCount": {
          "type": "integer",
          "minimum": 0
        },
        "buildSuccess": {
          "type": "boolean"
        }
      }
    },
    "notes": {
      "type": "string",
      "description": "Generator's notes or next steps."
    }
  }
}
