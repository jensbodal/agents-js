# Using -dot-
!_dot/

# TEMP
.obsidian/

# Dependencies
node_modules/

# Build output
out/
dist/
*.tgz

# _dot/ convention — visible tool configs (not committed)
_dot/

# Symlinks to _dot/ (tools expect dotfile locations)
.opencode
.gemini

# Local tool state
.codex/
.pi/
.mcp.json
gemini-extension.json
Procfile.docs

# Claude agent runtime state, drafts, plans — none of it belongs in the repo.
# Forward-looking specs live in Plane; implementation belongs in code + tests.
.claude/
.agents-js/config.json
.agents-js/profiles/
.agents-js/permission-rules.json
.agents-js/registry.json
_dot/a2a-sessions.json

# Logs
logs/
*.log

# Temporary
tmp/
.tmp/

# Code coverage
coverage/
*.lcov

# npm config — .npmrc is committed (scope only); auth lives in ~/.npmrc
# or a local override that merges at resolution time.
.npmrc.local

# Claude Code per-session permissions artifact.
settings.local.json

# dotenv
.env
.env.*.local

# Caches
# (removed .eslintcache — migrated to Biome)
.cache
*.tsbuildinfo
docs/.vitepress/cache/
docs/.vitepress/dist/
docs/.vitepress/.temp/

# Generated docs corpus served at /docs-index.json (build artifact, mirrored
# from packages/browser-runtime/dist/docs-index.json by build-docs-index.ts)
docs/public/docs-index.json

# Histoire component sandbox build output (regenerated by docs:stories).
docs/public/components/
output/
plans/
.playwright-cli/
.playwright-mcp/
.mana/
.overmind.sock
.overmind.env
.overmind.pids/

# IDE
.idea/
.vscode/

# OS
.DS_Store

