{
  "name": "@agents-js/host",
  "version": "0.3.2",
  "type": "module",
  "sideEffects": false,
  "description": "Host orchestration for the agents-js A2A gateway: ACP-backed A2A executor, AG-UI fetch handler, WebSocket bridge, and surface broadcaster.",
  "author": "Jens Bodal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jensbodal/agents-js.git",
    "directory": "packages/host"
  },
  "homepage": "https://agents-js.bodal.dev/",
  "bugs": {
    "url": "https://github.com/jensbodal/agents-js/issues"
  },
  "keywords": [
    "agent",
    "gateway",
    "host",
    "websocket",
    "a2a",
    "ag-ui"
  ],
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.11"
  },
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "bun": "./src/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./testing": {
      "types": "./dist/testing.d.mts",
      "bun": "./src/testing.ts",
      "import": "./dist/testing.mjs",
      "default": "./dist/testing.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "package.json"
  ],
  "scripts": {
    "build": "bunx tsdown src/index.ts src/testing.ts --format esm --dts --out-dir dist --clean",
    "prepack": "bun run build",
    "test": "bun test tests"
  },
  "dependencies": {
    "@a2a-js/sdk": "catalog:",
    "@agentclientprotocol/sdk": "catalog:",
    "@agents-js/a2a": "0.3.1",
    "@agents-js/a2a-client": "0.3.1",
    "@agents-js/a2ui-host": "0.3.1",
    "@agents-js/a2ui-types": "0.3.1",
    "@agents-js/acp": "0.3.1",
    "@agents-js/acp-host": "0.3.1",
    "@agents-js/agui-types": "0.3.1",
    "@agents-js/gateway-runtime": "0.3.1",
    "@agents-js/policy": "0.3.1",
    "@agents-js/validation": "0.3.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
