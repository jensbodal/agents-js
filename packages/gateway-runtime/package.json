{
  "name": "@agents-js/gateway-runtime",
  "version": "0.2.0",
  "type": "module",
  "sideEffects": false,
  "description": "Gateway runtime config, env parsing, runtime registry/detection, install descriptors, and sub-session spawn helpers.",
  "author": "Jens Bodal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jensbodal/agents-js.git",
    "directory": "packages/gateway-runtime"
  },
  "homepage": "https://agents-js.bodal.dev/",
  "bugs": {
    "url": "https://github.com/jensbodal/agents-js/issues"
  },
  "keywords": [
    "agent",
    "gateway",
    "runtime",
    "registry",
    "config"
  ],
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.11"
  },
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "browser": "./dist/browser.mjs",
      "bun": "./src/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "bin": {
    "mock-acp": "bin/mock-acp.ts"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "package.json"
  ],
  "scripts": {
    "build": "bunx tsdown src/index.ts src/browser.ts --format esm --dts --out-dir dist --clean",
    "prepack": "bun run build",
    "test": "bun test tests"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "catalog:",
    "@agents-js/a2a": "0.2.0",
    "@agents-js/acp": "0.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
