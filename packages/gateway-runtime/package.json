{
  "name": "@agents-js/gateway-runtime",
  "version": "0.2.0-beta-4",
  "type": "module",
  "sideEffects": false,
  "description": "Gateway runtime config, env parsing, runtime registry/detection, install descriptors, and sub-session spawn helpers.",
  "author": "Jens Bodal",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.11"
  },
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "browser": "./dist/browser.mjs",
      "bun": "./src/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "bin": {
    "mock-acp": "bin/mock-acp.ts"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "package.json"
  ],
  "scripts": {
    "build": "bunx tsdown src/index.ts src/browser.ts --format esm --dts --out-dir dist --clean",
    "test": "bun test tests"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "catalog:",
    "@agents-js/a2a": "0.2.0-beta-4",
    "@agents-js/acp": "0.2.0-beta-4"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
