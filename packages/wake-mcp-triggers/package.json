{
  "name": "@agents-js/wake-mcp-triggers",
  "version": "0.6.0",
  "type": "module",
  "sideEffects": false,
  "description": "Dispatcher-side serialization for the in-session-push wake-adapter shape (AJS-96). Wire format: notifications/wake. Not on the Claude Code receiver path per ADR-0007 revision; reference impl for the wake-adapter family. Per-harness terminal adapters (e.g. @agents-js/claude-channel-adapter for Claude Code) consume gateway wake events differently.",
  "author": "Jens Bodal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jensbodal/agents-js.git",
    "directory": "packages/wake-mcp-triggers"
  },
  "homepage": "https://agents-js.bodal.dev/",
  "bugs": {
    "url": "https://github.com/jensbodal/agents-js/issues"
  },
  "keywords": [
    "wake-adapter",
    "mcp",
    "agents",
    "notifications"
  ],
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.11"
  },
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "bun": "./src/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "package.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "bunx tsdown src/index.ts --format esm --dts --out-dir dist --clean",
    "prepack": "bun run build",
    "test": "bun test tests"
  },
  "dependencies": {
    "@agents-js/wake-types": "0.6.0"
  },
  "devDependencies": {
    "@types/bun": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
