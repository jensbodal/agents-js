{
  "name": "@agents-js/a2ui-types",
  "version": "0.5.1",
  "type": "module",
  "sideEffects": false,
  "description": "Thin re-export layer over @a2ui/web_core v0.9 plus a custom catalog for agents-js.",
  "author": "Jens Bodal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jensbodal/agents-js.git",
    "directory": "packages/a2ui-types"
  },
  "homepage": "https://agents-js.bodal.dev/",
  "bugs": {
    "url": "https://github.com/jensbodal/agents-js/issues"
  },
  "keywords": [
    "a2ui",
    "agents",
    "ui",
    "types",
    "zod"
  ],
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.11"
  },
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "bun": "./src/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./catalog": {
      "types": "./dist/catalog/index.d.mts",
      "bun": "./src/catalog/index.ts",
      "import": "./dist/catalog/index.mjs",
      "default": "./dist/catalog/index.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "package.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "bunx tsdown src/index.ts src/catalog/index.ts --format esm --dts --out-dir dist --clean",
    "prepack": "bun run build",
    "test": "bun test tests"
  },
  "dependencies": {
    "@a2ui/web_core": "0.10.0",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "zod": "^3"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/bun": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
