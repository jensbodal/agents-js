{
  "name": "@agents-js/validation",
  "version": "0.5.1",
  "type": "module",
  "sideEffects": false,
  "description": "Schema validation for ACP envelopes, A2A requests/responses, runtime manifests, and JSON-RPC messages.",
  "author": "Jens Bodal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jensbodal/agents-js.git",
    "directory": "packages/validation"
  },
  "homepage": "https://agents-js.bodal.dev/",
  "bugs": {
    "url": "https://github.com/jensbodal/agents-js/issues"
  },
  "keywords": [
    "acp",
    "a2a",
    "ag-ui",
    "a2ui",
    "json-rpc",
    "schema-validation",
    "ajv"
  ],
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.11"
  },
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "bun": "./src/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./a2a": {
      "types": "./dist/a2a.d.mts",
      "bun": "./src/a2a.ts",
      "import": "./dist/a2a.mjs",
      "default": "./dist/a2a.mjs"
    },
    "./a2a-metadata": {
      "types": "./dist/a2a-metadata.d.mts",
      "bun": "./src/a2a-metadata.ts",
      "import": "./dist/a2a-metadata.mjs",
      "default": "./dist/a2a-metadata.mjs"
    },
    "./a2ui": {
      "types": "./dist/a2ui.d.mts",
      "bun": "./src/a2ui.ts",
      "import": "./dist/a2ui.mjs",
      "default": "./dist/a2ui.mjs"
    },
    "./acp": {
      "types": "./dist/acp.d.mts",
      "bun": "./src/acp.ts",
      "import": "./dist/acp.mjs",
      "default": "./dist/acp.mjs"
    },
    "./agui": {
      "types": "./dist/agui.d.mts",
      "bun": "./src/agui.ts",
      "import": "./dist/agui.mjs",
      "default": "./dist/agui.mjs"
    },
    "./errors": {
      "types": "./dist/errors.d.mts",
      "bun": "./src/errors.ts",
      "import": "./dist/errors.mjs",
      "default": "./dist/errors.mjs"
    },
    "./loader": {
      "types": "./dist/loader.d.mts",
      "bun": "./src/loader.ts",
      "import": "./dist/loader.mjs",
      "default": "./dist/loader.mjs"
    },
    "./registry": {
      "types": "./dist/registry.d.mts",
      "bun": "./src/registry.ts",
      "import": "./dist/registry.mjs",
      "default": "./dist/registry.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "package.json",
    "LICENSE"
  ],
  "bin": {
    "agents-validate": "dist/cli.mjs"
  },
  "scripts": {
    "build": "bunx tsdown src/index.ts src/a2a.ts src/a2a-metadata.ts src/a2ui.ts src/acp.ts src/agui.ts src/cli.ts src/errors.ts src/loader.ts src/registry.ts --format esm --dts --out-dir dist --clean",
    "generate:acp": "bun ./scripts/generate-acp-schema.ts",
    "generate:acp:check": "bun ./scripts/generate-acp-schema.ts --check",
    "prepack": "bun run build",
    "test": "bun test tests"
  },
  "dependencies": {
    "@a2a-js/sdk": "catalog:",
    "@agents-js/a2ui-types": "0.5.1",
    "@agents-js/agui-types": "0.5.1",
    "@agentclientprotocol/sdk": "catalog:",
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@a2a-js/sdk": "^0.3.13",
    "@agentclientprotocol/sdk": "^0.24.0",
    "zod": "^3"
  },
  "peerDependenciesMeta": {
    "@a2a-js/sdk": {
      "optional": false
    },
    "@agentclientprotocol/sdk": {
      "optional": false
    },
    "zod": {
      "optional": false
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
