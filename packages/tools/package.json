{
  "name": "@agents-js/tools",
  "version": "0.3.3",
  "description": "Unified tool surface for agents-js: fetchContext coordinator (Shape 1) + findTools discovery surface (Shape 2). Single package for memory recall and tool discovery with a shared provenance schema.",
  "license": "MIT",
  "author": "Jens Bodal",
  "repository": {
    "type": "git",
    "url": "https://github.com/jensbodal/agents-js.git",
    "directory": "packages/tools"
  },
  "homepage": "https://agents-js.bodal.dev/",
  "bugs": {
    "url": "https://github.com/jensbodal/agents-js/issues"
  },
  "keywords": [
    "agent",
    "tools",
    "tracing",
    "gateway"
  ],
  "files": [
    "dist",
    "src",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "browser": "./dist/browser.mjs",
      "bun": "./src/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bunx tsdown src/index.ts src/browser.ts --format esm --dts --out-dir dist --clean",
    "prepack": "bun run build",
    "test": "bun test tests"
  },
  "engines": {
    "bun": ">=1.3.11",
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@agents-js/gateway-runtime": "0.3.3"
  }
}
