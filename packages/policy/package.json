{
  "name": "@agents-js/policy",
  "version": "0.3.2",
  "type": "module",
  "sideEffects": false,
  "description": "Stateless permission policy evaluation for ACP hosts. Pure functions with no framework dependencies.",
  "author": "Jens Bodal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jensbodal/agents-js.git",
    "directory": "packages/policy"
  },
  "homepage": "https://agents-js.bodal.dev/",
  "bugs": {
    "url": "https://github.com/jensbodal/agents-js/issues"
  },
  "keywords": [
    "acp",
    "permissions",
    "policy",
    "host"
  ],
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.11"
  },
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "browser": "./dist/browser.mjs",
      "bun": "./src/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./permission-types": {
      "types": "./dist/permission-types.d.mts",
      "bun": "./src/permission-types.ts",
      "import": "./dist/permission-types.mjs",
      "default": "./dist/permission-types.mjs"
    },
    "./terminal-policy": {
      "types": "./dist/terminal-policy.d.mts",
      "bun": "./src/terminal-policy.ts",
      "import": "./dist/terminal-policy.mjs",
      "default": "./dist/terminal-policy.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "package.json"
  ],
  "scripts": {
    "build": "bunx tsdown src/index.ts src/browser.ts src/permission-types.ts src/terminal-policy.ts --format esm --dts --out-dir dist --clean",
    "prepack": "bun run build",
    "test": "bun test tests"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
