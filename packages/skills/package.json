{
  "name": "@agents-js/skills",
  "version": "0.3.1",
  "type": "module",
  "sideEffects": false,
  "description": "TypeScript-native skill loading, validation, and in-memory registry for SKILL.md-formatted skills. Pure, filesystem-only, no network or persistence.",
  "author": "Jens Bodal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jensbodal/agents-js.git",
    "directory": "packages/skills"
  },
  "homepage": "https://agents-js.bodal.dev/",
  "bugs": {
    "url": "https://github.com/jensbodal/agents-js/issues"
  },
  "keywords": [
    "agent",
    "skills",
    "tools",
    "discovery"
  ],
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.11"
  },
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "bun": "./src/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "package.json"
  ],
  "scripts": {
    "build": "bunx tsdown src/index.ts --format esm --dts --out-dir dist --clean",
    "prepack": "bun run build",
    "test": "bun test tests"
  },
  "publishConfig": {
    "access": "public"
  }
}
