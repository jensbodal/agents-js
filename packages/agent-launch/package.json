{
  "name": "@agents-js/agent-launch",
  "version": "0.6.0",
  "type": "module",
  "sideEffects": false,
  "description": "Typed launcher for agents-js-managed tmux/harness sessions. Phase-1 slice (AJS-141): config loader, claude-code fresh-mode plan builder, git+MATRIX_AGENT identity env composition, tmux execFile wrapper. Replaces the dot-cognee `scripts/agent-launch.sh` bash original in phased increments; bridge preflight stays in dot-cognee per non-goal.",
  "author": "Jens Bodal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jensbodal/agents-js.git",
    "directory": "packages/agent-launch"
  },
  "homepage": "https://agents-js.bodal.dev/",
  "bugs": {
    "url": "https://github.com/jensbodal/agents-js/issues"
  },
  "keywords": [
    "launch",
    "tmux",
    "harness",
    "agents",
    "cli"
  ],
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.11"
  },
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "bun": "./src/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "defaults",
    "dist",
    "src",
    "package.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "bunx tsdown src/index.ts --format esm --dts --out-dir dist --clean",
    "prepack": "bun run build",
    "test": "bun test tests"
  },
  "dependencies": {
    "@agents-js/shell-args": "0.6.0"
  },
  "devDependencies": {
    "@types/bun": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
