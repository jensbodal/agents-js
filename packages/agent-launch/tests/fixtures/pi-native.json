{
  "version": "0.1.0",
  "description": "Test fixture — native pi agents: dual-window (TUI :0 + runtime :1) and single-window",
  "agents": {
    "pi-dual": {
      "tmux_session": "pi-dual",
      "harness": "pi",
      "binary": "pi",
      "workspace": "/tmp/pi-ws",
      "fresh_flags": "",
      "env_setup": "export MATRIX_AGENT=pi-dual",
      "channel_env": "export CH_GATEWAY_KEY_CMD=secret-cmd",
      "pi_host": "lan",
      "dual_window": true
    },
    "pi-solo": {
      "tmux_session": "pi-solo",
      "harness": "pi",
      "binary": "pi",
      "workspace": "/tmp/pi-ws",
      "fresh_flags": "",
      "env_setup": "export MATRIX_AGENT=pi-solo",
      "pi_host": "127.0.0.1"
    }
  }
}
