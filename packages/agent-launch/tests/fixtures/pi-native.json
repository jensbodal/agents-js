{
  "version": "0.1.0",
  "description": "Test fixture — native pi agents: cockpit (runtime :0, TUI :1, observe :2, logs :3) and single-window",
  "agents": {
    "pi-cockpit": {
      "tmux_session": "pi-cockpit",
      "harness": "pi",
      "binary": "pi",
      "workspace": "/tmp/pi-ws",
      "fresh_flags": "",
      "env_setup": "export MATRIX_AGENT=pi-cockpit",
      "channel_env": "export CH_GATEWAY_KEY_CMD=secret-cmd",
      "pi_host": "lan",
      "cockpit": true
    },
    "pi-solo": {
      "tmux_session": "pi-solo",
      "harness": "pi",
      "binary": "pi",
      "workspace": "/tmp/pi-ws",
      "fresh_flags": "",
      "env_setup": "export MATRIX_AGENT=pi-solo",
      "pi_host": "127.0.0.1"
    }
  }
}
