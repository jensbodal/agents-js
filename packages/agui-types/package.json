{
  "name": "@agents-js/agui-types",
  "version": "0.2.0-beta-4",
  "type": "module",
  "sideEffects": false,
  "description": "AG-UI core re-exports plus first-party message, reasoning, run, tool-call, and stream helpers for agents-js.",
  "author": "Jens Bodal",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.11"
  },
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "bun": "./src/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "package.json"
  ],
  "scripts": {
    "build": "bunx tsdown src/index.ts --format esm --dts --out-dir dist --clean",
    "test": "bun test tests"
  },
  "dependencies": {
    "@ag-ui/core": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
