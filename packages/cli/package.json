{
  "name": "@agents-js/cli",
  "version": "0.3.3",
  "type": "module",
  "description": "Terminal TUI and server commands for agents-js. Provides the agents-js executable with serve, client, and acp subcommands.",
  "author": "Jens Bodal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jensbodal/agents-js.git",
    "directory": "packages/cli"
  },
  "homepage": "https://agents-js.bodal.dev/",
  "bugs": {
    "url": "https://github.com/jensbodal/agents-js/issues"
  },
  "keywords": [
    "agent",
    "cli",
    "tui",
    "acp",
    "a2a",
    "agents-js"
  ],
  "engines": {
    "bun": ">=1.3.11"
  },
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "bun": "./src/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "package.json"
  ],
  "bin": {
    "agents-js": "dist/bin.mjs"
  },
  "scripts": {
    "build": "bun run build:pkg",
    "build:pkg": "bunx tsdown src/index.ts src/cli.ts src/bin.ts --format esm --dts --out-dir dist --clean",
    "build:standalone": "bun scripts/build-bin.ts",
    "client": "bun src/cli.ts client",
    "prepack": "bun run build",
    "serve": "bun src/cli.ts serve",
    "test": "bun test tests"
  },
  "dependencies": {
    "@agents-js/a2a-client": "0.3.3",
    "@agents-js/acp": "0.3.3",
    "@agents-js/acp-host": "0.3.3",
    "@agents-js/a2a": "0.3.3",
    "@agents-js/gateway-runtime": "0.3.3",
    "@agents-js/mcp-bridge": "0.3.3",
    "@agents-js/schema-utils": "0.3.3",
    "@modelcontextprotocol/sdk": "catalog:",
    "@opentui/core": "0.1.99",
    "@agentclientprotocol/claude-agent-acp": "0.33.1",
    "@zed-industries/codex-acp": "0.14.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
