{
  "name": "@agents-js/a2ui-host",
  "version": "0.3.3",
  "type": "module",
  "description": "Browser-side A2UI v0.9 host and bridge for agents-js.",
  "author": "Jens Bodal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jensbodal/agents-js.git",
    "directory": "packages/a2ui-host"
  },
  "homepage": "https://agents-js.bodal.dev/",
  "bugs": {
    "url": "https://github.com/jensbodal/agents-js/issues"
  },
  "keywords": [
    "a2ui",
    "ui",
    "browser",
    "host",
    "acp"
  ],
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.11"
  },
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "bun": "./src/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./acp-host": {
      "types": "./dist/acp-host/index.d.mts",
      "bun": "./src/acp-host/index.ts",
      "import": "./dist/acp-host/index.mjs",
      "default": "./dist/acp-host/index.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "package.json"
  ],
  "scripts": {
    "build": "bunx tsdown src/index.ts src/acp-host/index.ts --format esm --dts --out-dir dist --clean",
    "prepack": "bun run build",
    "test": "bun test tests",
    "typecheck": "bunx tsgo -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "catalog:",
    "@agents-js/acp-host": "0.3.3"
  },
  "peerDependencies": {
    "@agents-js/a2ui-types": "0.3.3",
    "@agents-js/ui-components": "0.3.3",
    "@agents-js/validation": "0.3.3",
    "lit": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
