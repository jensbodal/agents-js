{
  "name": "@agents-js/codex-gateway-inbox-receiver",
  "version": "0.6.0",
  "type": "module",
  "sideEffects": false,
  "description": "Native Codex receiver that polls the signed agents-js gateway inbox and delivers rows into Codex turns.",
  "author": "Jens Bodal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jensbodal/agents-js.git",
    "directory": "packages/codex-gateway-inbox-receiver"
  },
  "homepage": "https://agents-js.bodal.dev/",
  "bugs": {
    "url": "https://github.com/jensbodal/agents-js/issues"
  },
  "keywords": [
    "agents-js",
    "codex",
    "gateway",
    "inbox"
  ],
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.11"
  },
  "bin": {
    "codex-gateway-inbox-receiver": "dist/bin.mjs"
  },
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "bun": "./src/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "package.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "bunx tsdown src/index.ts src/bin.ts --format esm --dts --out-dir dist --clean",
    "prepack": "bun run build",
    "test": "bun test tests"
  },
  "dependencies": {
    "@agents-js/gateway-inbox-runtime": "0.6.0"
  },
  "devDependencies": {
    "@types/bun": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
