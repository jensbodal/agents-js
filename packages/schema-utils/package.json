{
  "name": "@agents-js/schema-utils",
  "version": "0.5.0",
  "type": "module",
  "sideEffects": false,
  "description": "Shared schema property parsing for ACP elicitation forms. Extracts field metadata from JSON Schema-like property definitions.",
  "author": "Jens Bodal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jensbodal/agents-js.git",
    "directory": "packages/schema-utils"
  },
  "homepage": "https://agents-js.bodal.dev/",
  "bugs": {
    "url": "https://github.com/jensbodal/agents-js/issues"
  },
  "keywords": [
    "json-schema",
    "acp",
    "elicitation",
    "form"
  ],
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.11"
  },
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "bun": "./src/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "package.json"
  ],
  "scripts": {
    "build": "bunx tsdown src/index.ts --format esm --dts --out-dir dist --clean",
    "prepack": "bun run build",
    "test": "bun test tests"
  },
  "publishConfig": {
    "access": "public"
  }
}
