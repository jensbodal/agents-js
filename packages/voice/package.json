{
  "name": "@agents-js/voice",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Voice M2 seams for agents-js: a named A2A target plus the transcript-in / speakable response-out text normalizers that bridge a fixed-window STT transcript to a TTS-ready reply.",
  "author": "Jens Bodal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jensbodal/agents-js.git",
    "directory": "packages/voice"
  },
  "homepage": "https://agents-js.bodal.dev/",
  "bugs": {
    "url": "https://github.com/jensbodal/agents-js/issues"
  },
  "keywords": [
    "voice",
    "a2a",
    "tts",
    "transcript",
    "speech"
  ],
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.11"
  },
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "bun": "./src/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "package.json"
  ],
  "scripts": {
    "build": "bunx tsdown src/index.ts --format esm --dts --out-dir dist --clean",
    "prepack": "bun run build",
    "test": "bun test tests"
  }
}
