{
  "name": "@agents-js/wake-signal-store",
  "version": "0.5.1",
  "type": "module",
  "sideEffects": false,
  "description": "Durable wake-signal store for the AJS-89 HYBRID gateway substrate. Source-side persistence + at-least-once delivery dedup for wake signals consumed by per-harness terminal adapters (e.g. @agents-js/claude-channel-adapter). Persistence-backend swap shape (in-mem → SQLite → Postgres) baked into the Backend interface.",
  "author": "Jens Bodal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jensbodal/agents-js.git",
    "directory": "packages/wake-signal-store"
  },
  "homepage": "https://agents-js.bodal.dev/",
  "bugs": {
    "url": "https://github.com/jensbodal/agents-js/issues"
  },
  "keywords": [
    "wake-adapter",
    "signal-store",
    "agents",
    "gateway"
  ],
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.11"
  },
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "bun": "./src/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "package.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "bunx tsdown src/index.ts --format esm --dts --out-dir dist --clean",
    "prepack": "bun run build",
    "test": "bun test tests"
  },
  "dependencies": {
    "@agents-js/wake-types": "0.5.1"
  },
  "devDependencies": {
    "@types/bun": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
