{
  "name": "@agents-js/a2a",
  "version": "0.3.2",
  "type": "module",
  "sideEffects": false,
  "description": "A2A server — wraps an ACP agent as an HTTP JSON-RPC + SSE streaming endpoint with CORS support.",
  "author": "Jens Bodal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jensbodal/agents-js.git",
    "directory": "packages/a2a"
  },
  "homepage": "https://agents-js.bodal.dev/",
  "bugs": {
    "url": "https://github.com/jensbodal/agents-js/issues"
  },
  "keywords": [
    "a2a",
    "json-rpc",
    "sse",
    "streaming",
    "agent",
    "server"
  ],
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.11"
  },
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "bun": "./src/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./audit": {
      "types": "./dist/audit.d.mts",
      "bun": "./src/audit.ts",
      "import": "./dist/audit.mjs",
      "default": "./dist/audit.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "package.json"
  ],
  "scripts": {
    "build": "bunx tsdown src/index.ts src/audit.ts --format esm --dts --out-dir dist --clean",
    "prepack": "bun run build",
    "test": "bun test tests"
  },
  "dependencies": {
    "@a2a-js/sdk": "catalog:",
    "@agentclientprotocol/sdk": "catalog:",
    "@agents-js/acp": "0.3.1",
    "@agents-js/validation": "0.3.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
