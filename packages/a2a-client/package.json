{
  "name": "@agents-js/a2a-client",
  "version": "0.3.3",
  "type": "module",
  "sideEffects": false,
  "description": "A2A client transport, AG-UI adapter, target registry, session view-model, and discovery helpers for agents-js consumers.",
  "author": "Jens Bodal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jensbodal/agents-js.git",
    "directory": "packages/a2a-client"
  },
  "homepage": "https://agents-js.bodal.dev/",
  "bugs": {
    "url": "https://github.com/jensbodal/agents-js/issues"
  },
  "keywords": [
    "a2a",
    "client",
    "ag-ui",
    "agent",
    "discovery",
    "registry"
  ],
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.11"
  },
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "bun": "./src/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./node": {
      "types": "./dist/node.d.mts",
      "bun": "./src/node.ts",
      "import": "./dist/node.mjs",
      "default": "./dist/node.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "package.json"
  ],
  "scripts": {
    "build": "bunx tsdown src/index.ts src/node.ts --format esm --dts --out-dir dist --clean",
    "prepack": "bun run build",
    "test": "bun test tests",
    "test:integration": "bun test tests/integration.test.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "catalog:",
    "@a2a-js/sdk": "catalog:",
    "@agents-js/a2a": "0.3.2",
    "@agents-js/agui-types": "0.3.2",
    "@agents-js/validation": "0.3.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
