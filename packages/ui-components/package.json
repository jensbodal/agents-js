{
  "name": "@agents-js/ui-components",
  "version": "0.5.1",
  "type": "module",
  "description": "Lit web components for ACP-aware chat interfaces. Drop-in surface with streaming, permissions, elicitation, auth, and theming.",
  "author": "Jens Bodal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jensbodal/agents-js.git",
    "directory": "packages/ui-components"
  },
  "homepage": "https://agents-js.bodal.dev/",
  "bugs": {
    "url": "https://github.com/jensbodal/agents-js/issues"
  },
  "keywords": [
    "lit",
    "web-components",
    "acp",
    "chat",
    "ui",
    "agent-ui"
  ],
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.11"
  },
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "bun": "./src/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./connect-preferences": {
      "types": "./dist/connect-preferences-store.d.mts",
      "bun": "./src/connect-preferences-store.ts",
      "import": "./dist/connect-preferences-store.mjs",
      "default": "./dist/connect-preferences-store.mjs"
    },
    "./web-ui-glue": {
      "bun": "./src/web-ui-glue.ts",
      "import": "./dist/web-ui-glue.mjs",
      "types": "./dist/web-ui-glue.d.mts",
      "default": "./dist/web-ui-glue.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "package.json"
  ],
  "scripts": {
    "build": "bun build.ts",
    "build:watch": "bun build.ts --watch",
    "prepack": "bun run build",
    "stories:build": "bun run build && bunx histoire build",
    "stories:dev": "bun run build && (bun run build:watch & bunx histoire dev)",
    "test": "bun test tests",
    "typecheck": "bunx tsgo -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "catalog:",
    "@agents-js/a2ui-types": "0.5.0",
    "@agents-js/acp-host": "0.5.0",
    "@agents-js/schema-utils": "0.5.0"
  },
  "devDependencies": {
    "@histoire/plugin-vue": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "histoire": "catalog:",
    "vue": "catalog:"
  },
  "peerDependencies": {
    "lit": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
