{
  "name": "@agents-js/memory-postgres",
  "version": "0.5.1",
  "type": "module",
  "sideEffects": false,
  "description": "PostgreSQL Storage backend for the agents-js MemoryProvider. Plugs into @agents-js/memory-local's LocalMemoryProvider via the public Storage seam. Implements substrate read primitives (get + listByScope) per ADR 0001 using indexed cursor-based pagination.",
  "author": "Jens Bodal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jensbodal/agents-js.git",
    "directory": "packages/memory-postgres"
  },
  "homepage": "https://agents-js.bodal.dev/",
  "bugs": {
    "url": "https://github.com/jensbodal/agents-js/issues"
  },
  "keywords": [
    "memory",
    "agents-js",
    "provider",
    "postgres",
    "postgresql",
    "storage"
  ],
  "engines": {
    "bun": ">=1.3.11",
    "node": ">=20"
  },
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "bun": "./src/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "build": "bunx tsdown src/index.ts --format esm --dts --out-dir dist --clean",
    "prepack": "bun run build",
    "test": "bun test tests",
    "typecheck": "bunx tsgo -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agents-js/memory": "0.5.1",
    "@agents-js/memory-local": "0.5.1",
    "postgres": "^3.4.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
