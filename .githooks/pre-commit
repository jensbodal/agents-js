#!/usr/bin/env bash
#
# Pre-commit hook: auto-format, auto-fix lint, then run fast quality checks.
# Heavier build+test gate is in .githooks/pre-push (mise run ci).
# Full CI (docs, e2e, browser smoke) runs in the configured CI provider, not here.
# Install: git config core.hooksPath .githooks
#
# Philosophy: formatting and safe lint nits are fixed automatically so agents
# and humans only need to manually fix what the tooling cannot (real type
# errors, non-auto-fixable lint, failing tests).
#
set -euo pipefail

# Snapshot the list of originally-staged files so we can re-stage them after
# auto-fix. Files not in this list but modified by biome stay unstaged — we
# only want the commit to carry fixes to files the caller intended to commit.
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

# Lockfile-sync gate: if any package.json was staged, run `bun install` so
# bun.lock stays in sync with package.json in the SAME commit. Without this,
# a partial commit (package.json without bun.lock) can land with stale lock,
# and CI's --frozen-lockfile path catches the divergence only after the push
# — late signal we want to short-circuit at commit time.
PKG_JSON_CHANGED=$(echo "$STAGED_FILES" | grep -E '(^|/)package\.json$' || true)
if [ -n "$PKG_JSON_CHANGED" ]; then
  echo "🔄 Pre-commit lockfile sync: package.json changed, running bun install..."
  bun install >/dev/null
  # Always append bun.lock to STAGED_FILES — if bun install didn't change it,
  # `git add bun.lock` is a no-op; if it did, we capture the sync in the
  # commit. The auto-stage loop below picks it up uniformly.
  STAGED_FILES="$STAGED_FILES"$'\n'"bun.lock"
fi

echo "🔧 Pre-commit auto-fix: bun run format..."
bun run format >/dev/null

# biome check --write applies the subset of lint rules that biome knows how to
# fix safely (unused imports, simple organization, etc.). Unfixable lint is
# passed through to the final `bun run check` gate below, which will fail
# commits with real issues.
echo "🔧 Pre-commit auto-fix: biome check --write (safe lint fixes)..."
bunx biome check --write . >/dev/null || true

# Re-stage any originally-staged files that the auto-fix touched so the
# commit carries the fixed version. Files outside this list that biome
# happened to modify stay in the worktree, unstaged.
if [ -n "$STAGED_FILES" ]; then
  while IFS= read -r f; do
    if [ -f "$f" ]; then
      # `-f` lets us re-stage intentionally force-added paths (e.g. files
      # under gitignored trees like `_dot/` that the caller explicitly
      # staged). Without `-f`, those re-adds fail and break the commit.
      git add -f "$f"
    fi
  done <<< "$STAGED_FILES"
fi

echo "🔍 Running pre-commit check (bun run check)..."
bun run check

# Catalog-drift gate: when the publisher's ROOT package.json is staged (the
# file that owns the workspace `catalog`), every registered downstream
# consumer's root catalog must mirror the publisher's. If a consumer drifts,
# cold installs in that repo fail with `<pkg>@catalog: failed to resolve`.
# Per-package package.json edits inside packages/* don't trigger this — only
# the root file owns catalog declarations.
#
# Trigger: root package.json staged (path is exactly "package.json", no slash).
# Detector: skills-js/catalog-drift-detector run against omd-claude config.
# Fail mode: closed (block commit) when detector found and drift present;
#            open (warn) when detector not present (agents-js cloned standalone
#            outside the orchestrator topology has no detector to run).
ROOT_PKG_STAGED=$(echo "$STAGED_FILES" | grep -E '^package\.json$' || true)
if [ -n "$ROOT_PKG_STAGED" ]; then
  # Probe the well-known orchestrator topology. The detector lives in the
  # skills-js worktree adjacent to agents-js. If the user has a different
  # checkout layout, set CATALOG_DRIFT_DETECTOR to override.
  DETECTOR="${CATALOG_DRIFT_DETECTOR:-}"
  if [ -z "$DETECTOR" ]; then
    for candidate in \
      "$HOME/workspace/omd-workspace/omd-claude/.worktrees/skills-js/skills/catalog-drift-detector/scripts/detect-drift.ts" \
      "$HOME/workspace/skills-js/skills/catalog-drift-detector/scripts/detect-drift.ts"; do
      if [ -f "$candidate" ]; then
        DETECTOR="$candidate"
        break
      fi
    done
  fi
  CONFIG="${CATALOG_DRIFT_CONFIG:-$HOME/workspace/omd-workspace/omd-claude/config.json}"

  if [ -n "$DETECTOR" ] && [ -f "$CONFIG" ]; then
    echo "🔍 Pre-commit catalog-drift gate: root package.json staged, validating consumer catalogs..."
    if ! bun "$DETECTOR" --config "$CONFIG" --check; then
      echo ""
      echo "❌ Catalog drift detected. The publisher's root catalog has changed but"
      echo "   one or more registered consumers (config.json#consumerPairs) have stale"
      echo "   mirrors. Mirror the change into every consumer in the same operator"
      echo "   session, then re-stage. See"
      echo "   ~/workspace/omd-workspace/omd-claude/.claude/rules/dependency-currency.md"
      echo "   §'Cross-repo workaround: workspace-protocol consumer pairs' for the"
      echo "   discipline."
      exit 1
    fi
    echo "✅ Consumer catalogs in sync with publisher."
  else
    echo "⚠️  catalog-drift detector not found — skipping consumer-catalog gate."
    echo "   Set CATALOG_DRIFT_DETECTOR=path/to/detect-drift.ts (and"
    echo "   CATALOG_DRIFT_CONFIG=path/to/config.json) to enable, or check that"
    echo "   skills-js + omd-claude are present in the standard topology."
  fi
fi

echo "✅ All checks passed."
