#!/usr/bin/env bash
#
# Pre-push hook: full local gate before any push.
#
# Two phases, in order:
#   1. `bun install` — refresh workspace symlinks in node_modules/@agents-js/*.
#      Side-effectful; self-heals stale symlinks that drift when sibling
#      packages are added/renamed between pushes. Idempotent (reports
#      "(no changes)" on cache hit, ~10ms).
#   2. `mise run ci` — the validation gate: generated-doc drift checks,
#      typecheck, lint, and tests via the serialized task graph in mise.toml.
#
# Why phase 1 exists: adding or renaming workspace packages can leave
# node_modules/@agents-js/* symlinks stale until the next install. Refreshing
# before the validation gate prevents typecheck and docs generation from seeing
# a half-bootstrapped package graph.
#
# Bypass: `git push --no-verify` or `SKIP_PREPUSH=1 git push`. Discouraged
# — if bun install fails, that's a real dep-graph problem worth
# investigating, not routing around.
#
# Full CI (docs, e2e, browser smoke) runs in the configured CI provider.
#
set -euo pipefail

if [[ "${SKIP_PREPUSH:-0}" == "1" ]]; then
  echo "⏭  SKIP_PREPUSH=1 — skipping pre-push gate."
  exit 0
fi

echo "🔄 Pre-push phase 1/2: refreshing workspace symlinks (bun install)..."
if ! bun install; then
  echo ""
  echo "Pre-push gate FAILED: 'bun install' returned non-zero." >&2
  echo "Resolve the dependency problem before pushing." >&2
  exit 1
fi

echo "🔒 Pre-push phase 2/2: running validation gate (mise run ci)..."
if ! mise run ci; then
  echo ""
  echo "Pre-push gate FAILED: 'mise run ci' returned non-zero." >&2
  echo "Fix the failing step and retry, or bypass with SKIP_PREPUSH=1 (not recommended)." >&2
  exit 1
fi

echo "✅ Pre-push gate passed."
