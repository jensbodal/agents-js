{
  "name": "@agents-js/root",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ACP runtimes over A2A — operator CLI and reusable client library",
  "author": "jensbodal",
  "license": "MIT",
  "keywords": [
    "acp",
    "a2a",
    "agent",
    "typescript",
    "cli",
    "client",
    "validation"
  ],
  "workspaces": [
    "packages/*",
    "apps/*",
    "extras/*",
    "tests/trial-agent"
  ],
  "catalog": {
    "@a2a-js/sdk": "0.3.13",
    "@ag-ui/core": "0.0.52",
    "@agentclientprotocol/sdk": "0.21.0",
    "@biomejs/biome": "2.4.13",
    "@braintree/sanitize-url": "7.1.2",
    "@mlc-ai/web-llm": "0.2.82",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@sinclair/typebox": "0.34.49",
    "@types/bun": "1.3.13",
    "@typescript/native-preview": "7.0.0-dev.20260426.1",
    "@vue/server-renderer": "3.5.33",
    "@webgpu/types": "0.1.69",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "cytoscape": "3.33.2",
    "cytoscape-cose-bilkent": "4.1.0",
    "dayjs": "1.11.20",
    "debug": "4.4.3",
    "esbuild": "0.28.0",
    "lit": "3.3.2",
    "mermaid": "11.14.0",
    "tsdown": "0.21.10",
    "typedoc": "0.28.19",
    "typedoc-plugin-markdown": "4.11.0",
    "typedoc-vitepress-theme": "1.1.2",
    "vite": "8.0.10",
    "vite-plus": "0.1.19",
    "vitepress": "1.6.4",
    "vitepress-plugin-mermaid": "2.0.17",
    "vue": "3.5.33",
    "zod": "3.25.76"
  },
  "scripts": {
    "docs:api": "typedoc --options typedoc.config.json && bun scripts/docs-api-postprocess.ts && bunx biome format --write docs/api/typedoc-sidebar.json",
    "docs:build": "bun run docs:api && bun run docs:index && npx vitepress build docs",
    "docs:bundle": "bun scripts/docs-bundle.ts",
    "docs:dev": "bun run docs:api && bun run docs:index && vitepress dev docs --open",
    "docs:index": "bun scripts/build-docs-index.ts",
    "docs:consistency": "bun scripts/docs-consistency.ts",
    "docs:readmes": "bun scripts/generate-package-readmes.ts",
    "docs:smoke": "bun scripts/check-docs-playground.ts",
    "docs:typecheck-handauth": "bun scripts/test-docs-handauth.ts",
    "bump": "bun scripts/bump.ts",
    "dashboard": "bun scripts/dep-graph-gen.ts && bun scripts/test-counts.ts && bun scripts/build-dashboard.ts",
    "release:preflight": "bun scripts/release-preflight.ts",
    "setup": "bun scripts/setup.ts",
    "dev": "vp run -w repo:dev",
    "e2e:gateway": "vp run --no-cache -w repo:e2e:gateway",
    "e2e:runtime": "vp run --no-cache -w repo:e2e:runtime",
    "e2e:web:live": "vp run --no-cache -w repo:e2e:web:live",
    "e2e:deterministic": "bun scripts/build.ts && vp run --no-cache -w repo:e2e:deterministic",
    "e2e": "vp run --no-cache -w repo:e2e",
    "browser:smoke": "vp run --no-cache -w repo:browser:smoke",
    "build": "vp run -w repo:build && cd packages/cli && bun link",
    "test": "bun scripts/build.ts && bun test --max-concurrency=1 --retry=1 ./tests ./packages ./apps ./docs",
    "test:random": "bun scripts/build.ts && bun test --randomize --max-concurrency=1 --retry=1 ./tests ./packages ./apps ./docs",
    "check": "bun run release:preflight && bun scripts/validate-build-graph.ts && bun run --cwd packages/validation generate:acp:check && bun run typecheck && bunx biome check . --error-on-warnings && bun run check:operator-strings && bun run docs:api && bun run docs:smoke && bun run docs:consistency",
    "check:operator-strings": "bun scripts/check-operator-strings.ts",
    "typecheck": "bunx tsgo --noEmit && bun run --cwd packages/ui-components typecheck && bun run --cwd packages/a2ui-renderer typecheck && bun run --cwd packages/a2ui-host typecheck",
    "lint": "bunx biome lint .",
    "lint:fix": "bunx biome check --write .",
    "format": "bunx biome format --write .",
    "test:docs": "bun run docs:api && bun scripts/test-docs.ts",
    "test:vp": "vp run -w repo:test",
    "ci": "bun run e2e:deterministic",
    "clean": "rm -rf .tmp docs/.vitepress/cache",
    "clean:dist": "bun run clean && rm -rf docs/.vitepress/dist docs/api packages/*/dist apps/*/dist",
    "clean:all": "bun run clean:dist && rm -rf node_modules bun.lockb"
  },
  "devDependencies": {
    "@agents-js/a2a": "workspace:*",
    "@agents-js/a2a-client": "workspace:*",
    "@agents-js/a2ui-host": "workspace:*",
    "@agents-js/a2ui-renderer": "workspace:*",
    "@agents-js/a2ui-types": "workspace:*",
    "@agents-js/acp": "workspace:*",
    "@agents-js/acp-host": "workspace:*",
    "@agents-js/agui-types": "workspace:*",
    "@agents-js/browser-runtime": "workspace:*",
    "@agents-js/cli": "workspace:*",
    "@agents-js/gateway-runtime": "workspace:*",
    "@agents-js/host": "workspace:*",
    "@agents-js/plane": "workspace:*",
    "@agents-js/policy": "workspace:*",
    "@agents-js/reporting": "workspace:*",
    "@agents-js/schema-utils": "workspace:*",
    "@agents-js/tools": "workspace:*",
    "@agents-js/trial-agent": "workspace:*",
    "@agents-js/ui-components": "workspace:*",
    "@agents-js/validation": "workspace:*",
    "@biomejs/biome": "catalog:",
    "@braintree/sanitize-url": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@vue/server-renderer": "catalog:",
    "cytoscape": "catalog:",
    "cytoscape-cose-bilkent": "catalog:",
    "dayjs": "catalog:",
    "debug": "catalog:",
    "esbuild": "catalog:",
    "lit": "catalog:",
    "mermaid": "catalog:",
    "tsdown": "catalog:",
    "typedoc": "catalog:",
    "typedoc-plugin-markdown": "catalog:",
    "typedoc-vitepress-theme": "catalog:",
    "vite-plus": "catalog:",
    "vitepress": "catalog:",
    "vitepress-plugin-mermaid": "catalog:",
    "vue": "catalog:"
  },
  "overrides": {
    "@biomejs/cli-linux-x64-musl": "npm:@biomejs/cli-linux-x64@2.4.12",
    "@biomejs/cli-linux-arm64-musl": "npm:@biomejs/cli-linux-arm64@2.4.12"
  },
  "packageManager": "bun@1.3.12"
}
